{
  "manifest_version": 3,
  "name": "niconico-speenya",
  "version": "PACKAGE_VERSION_SHOLD_BE_REPLACED",
  "description": "The niconico method presentation for Google Chrome",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "NicoNico SPEENYA"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "css": ["styles/content_style.css"],
      "js": ["scripts/content_script.js", "scripts/vendor.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["*://*/*"]
    }
  ],
  "permissions": [
    "contextMenus",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
